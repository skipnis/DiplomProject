POSTGRES_DB=wishapp_db
POSTGRES_USER=wishapp
POSTGRES_PASSWORD=wishapp

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

ConnectionStrings__Database=Host=postgres;Database=wishapp_db;Username=wishapp;Password=wishapp

Jwt__Secret=your-super-secret-key-at-least-32-characters
Jwt__Issuer=wishapp
Jwt__Audience=wishapp
Jwt__ExpirationInMinutes=15
Jwt__RefreshTokenExpirationInDays=30

Google__ClientId=your-google-client-id
Google__ClientSecret=your-google-client-secret

Minio__Endpoint=minio:9000
Minio__AccessKey=minioadmin
Minio__SecretKey=minioadmin
Minio__BucketName=wishapp
Minio__PublicUrl=http://localhost:9000

QrCode__FrontendUrl=http://localhost:5173

Smtp__Host=mailpit
Smtp__Port=1025
Smtp__From=noreply@wishapp.local

Cors__AllowedOrigin=http://localhost:5173

Admin__Username=admin
Admin__Password=your-admin-password

VITE_GOOGLE_CLIENT_ID=your-google-client-id
